---
import DocPage from '../../../components/DocPage.astro';
import { pages, type Page } from '../../../lib/sections';

export async function getStaticPaths() {
  return (await Promise.all([pages('zh-CN'), pages('ko')])).flat().map((page) => ({
    params: { locale: page.lang, section: page.section, slug: page.slug === 'index' ? undefined : page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: Page };
---

<DocPage page={page} />

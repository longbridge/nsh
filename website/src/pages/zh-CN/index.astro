---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Home from '../../components/Home.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { url } from '../../lib/site';
---

<BaseLayout
  lang="zh-CN"
  title="Native Shell — AI 生成的界面，原生地运行在你的应用里"
  description="Native Shell：为 AI 生成界面而设计，覆盖每个平台。用 Rust 或 TSX 为 iOS、Android、macOS、Windows、Linux、GPUI 和 Web 编写应用，以各平台自己的界面绘制，并在运行时向它们交付经签名的 TSX 模块。"
  alternates={{ en: '/', 'zh-CN': '/zh-CN' }}
>
  <Nav lang="zh-CN" currentPath={Astro.url.pathname} langHref={url('')} />
  <Home lang="zh-CN" />
  <SiteFooter lang="zh-CN" />
</BaseLayout>

      `        &lt;${ty('Text')} class=${st('"text-white"')}&gt;Tap&lt;/${ty('Text')}&gt;`,
      `      &lt;/${ty('View')}&gt;`,
      `    &lt;/${ty('View')}&gt;`,
      `  );`,
      `}`,
      `${fn('mount')}(App);`,
    ].join('\n'),
  },
];



---
// The landing page. Structure and rules follow gpui-kit.com (DESIGN.md):
// one container per band, hairline separators, restraint, verifiable
// specifics. The hero runs the gallery's AI chat live (demos/home-chat.tsx
// on the web runtime) in a frame of the site's design.
import { BASE, url, type Lang } from '../lib/site';
import { hasPlayer } from '../lib/demo.js';
import HeroField from './HeroField.astro';

export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh-CN';
const link = (path: string) => url(zh ? `zh-CN/${path}` : path);
const player = hasPlayer();
const chatSrc = `${BASE}play/index.html?theme=dark#home-chat`;

const copy = zh
  ? {
      eyebrow: '为 AI 生成界面而设计',
      title: ['AI 生成的界面，', '原生地运行在你的应用里'],
      lead: 'Native Shell 让 iOS、Android、macOS、Windows、Linux 上的应用、GPUI 应用和网页在运行时加载用 TSX 编写的模块——由模型或你的团队编写——经过签名校验，运行在宿主配置的沙箱里，并用每个平台自己的界面技术绘制。',
      start: '阅读简介',
      try: '在线试用',
      meta: [
        ['scale', '开源 · Apache-2.0'],
        ['building', '由长桥（Longbridge）构建'],
      ],
      runsOn: '一个模块，手机和桌面都能运行',
      snippetLang: 'CLI',
      demo: {
        title: 'Chat.tsx',
        badge: '运行中',
        frame: '在线示例：AI 聊天',
        caption: '示例应用里的 AI 聊天，用 TSX 编写，在这里由 Native Shell 的 Web 运行时在浏览器中实时运行。回复是本地脚本模拟的流式输出；可以点建议或用 + 重放场景。',
        pending: '在线预览尚未构建：运行 bun run dev（或 cargo xtask web）。',
      },
      replay: '重播',
      capKicker: 'AI 友好',
      capTitle: '为模型编写、为宿主把关而设计',
      capLead: '生成的界面要是真正的原生界面，能作为插件装进已经发布的应用或独立成应用，还要好写、可验证、跑得安全。NSH 的每一层都围绕这几点设计。',
      usesKicker: '三种用法',
      usesTitle: '同一个模块，三种用法',
      usesLead: '首要用途是 AI 生成的界面；同一套机制也让原生应用可以扩展，或者直接组成一个独立应用。',
      howKicker: '工作原理',
      howTitle: '在服务器上生成，在设备上被信任',
      howLead: '服务器负责生成、检查和签名；设备负责校验、隔离和渲染。信任边界清清楚楚。',
      platKicker: '平台',
      platTitle: '每个平台，都用它自己的界面',
      platLead: '同一个 bundle 和同一个 Rust 运行时：在每个平台上，模块都可以嵌入已有的应用、借助热更新开发，也可以打包成可安装的应用。GPUI 后端用一套渲染覆盖三个桌面平台，并能嵌入 GPUI 与 GPUI Kit 应用；Web 平台把应用渲染成网页里的 HTML。',
      principleKicker: '原则',
      principle: ['模型负责编写界面，', '宿主决定它能做什么'],
      principleBody: '模块只能看到宿主授予的能力，只占用宿主允许的资源，只在签名校验通过后运行。剩下的——文本、输入、无障碍、动画——交给系统的原生视图。',
      principleCta: '在线试用',
    }
  : {
      eyebrow: 'Built for AI-generated UI',
      title: ['AI-generated UI,', 'native in your app.'],
      lead: 'Native Shell lets apps on iOS, Android, macOS, Windows and Linux, GPUI apps and web pages load modules written in TSX — by a model or by your team — at run time: signature-checked, sandboxed by rules the host sets, and drawn with each platform’s own UI.',
      start: 'Read the introduction',
      try: 'Try the playground',
      meta: [
        ['scale', 'Open source · Apache-2.0'],
        ['building', 'Built at Longbridge'],
      ],
      runsOn: 'One module, on phones and desktops',
      snippetLang: 'CLI',
      demo: {
        title: 'Chat.tsx',
        badge: 'Live',
        frame: 'Live demo: AI chat',
        caption: 'The gallery’s AI chat, written in TSX and running live here in your browser on Native Shell’s web runtime. Replies are scripted and streamed locally; tap a suggestion or + to replay a scenario.',
        pending: 'The live preview is not built yet: run bun run dev (or cargo xtask web).',
      },
      replay: 'Replay',
      capKicker: 'AI friendly',
      capTitle: 'Designed for models to write and hosts to trust.',
      capLead: 'Generated UI has to be truly native, plug into apps that have already shipped or stand alone as an app, and be easy to write, checkable and safe to run. Every layer of NSH is built around that.',
      usesKicker: 'Three uses',
      usesTitle: 'One module, three ways to use it.',
      usesLead: 'AI-generated UI is what NSH is designed for. The same mechanism makes native apps extensible, or becomes a whole app.',
      howKicker: 'How it works',
      howTitle: 'Generated on the server, trusted on the device.',
      howLead: 'The server generates, checks and signs; the device verifies, confines and renders. The trust boundary stays explicit.',
      platKicker: 'Platforms',
      platTitle: 'Every platform, in its own UI.',
      platLead: 'One bundle and one Rust runtime: on each platform, modules embed in an existing app, develop with hot reload, and can also be packaged as an installable app. The GPUI backend covers the three desktops with one renderer and embeds in GPUI and GPUI Kit apps; the web platform renders apps as HTML in a page.',
      principleKicker: 'Principle',
      principle: ['Models write the interface.', 'The host decides what it may do.'],
      principleBody: 'A module sees only the capabilities the host grants, uses only the resources it allows, and runs only after its signature checks out. Everything else — text, input, accessibility, animation — belongs to the system’s native views.',
      principleCta: 'Try the playground',
    };

const caps = zh
  ? [
      { id: 'native', icon: 'devices', title: '真正的原生界面', body: '模块在手机上由 UIKit 与 Android 视图组成，在桌面上由 AppKit、GTK 4 以及用 Direct2D 绘制的 Win32 窗口呈现，在 GPUI 应用里由 GPUI 绘制，在浏览器里是网页的 HTML。地图、网页视图这类原生组件可以直接嵌入，与界面自然叠放；系统的文本、输入法和无障碍都原样可用。', chips: ['UIView', 'android.view.View', 'NSView', 'GtkWidget', 'Direct2D', 'GPUI', 'HTML'] },
      { id: 'plugin', icon: 'plug', title: '插件，或独立应用', body: '在已有应用的任意页面放一个 NshAppView（iOS）、NshView（Android）、AppView（桌面，以及作为 GPUI 视图放进 GPUI 应用），或在网页里用 createPlayer 加载，运行时动态加载模块，新功能随时上线；同样的模块也能用 nsh package 打成独立应用或静态网站。', chips: ['NshAppView', 'NshView', 'AppView', 'createPlayer', 'nsh package'] },
      { id: 'tsx', icon: 'spark', title: 'AI 友好：TSX + Tailwind', body: '一个模块就是一个 TSX 文件：组件、信号和 Tailwind 类，正是模型最擅长写的格式。每个元素、属性和模块都有从 Rust 源码生成的 TypeScript 声明，文档以 llms.txt 提供给模型。', chips: ['TSX', 'Tailwind', 'llms.txt'] },
      { id: 'check', icon: 'check', title: '在服务器上就能验证', body: 'nsh trace 无界面地运行模块并报告错误；编译器还能在进程内或浏览器里运行。生成、检查、重试。', chips: ['nsh trace', 'compile_module'] },
      { id: 'sandbox', icon: 'lock', title: '不可信，也能安全运行', body: '每个视图一个 QuickJS 虚拟机，内存、调用时长和节点数都有上限，只能使用宿主授予的能力。', chips: ['NshLimits', 'grantCapabilities'] },
      { id: 'signed', icon: 'shield', title: '签名下发，可吊销', body: '模块以 Ed25519 签名的 .nshpkg 到达；发布密钥由离线根密钥认证，设备端检查吊销列表。', chips: ['nsh publish', 'NshTrust'] },
    ]
  : [
      { id: 'native', icon: 'devices', title: 'Real native UI', body: 'Modules are UIKit and Android views on phones, AppKit views, GTK 4 widgets and Win32 windows drawn with Direct2D on the desktop, GPUI elements in GPUI apps, and HTML in a web page. Native components such as maps and web views layer in naturally, and the system’s text, input and accessibility just work.', chips: ['UIView', 'android.view.View', 'NSView', 'GtkWidget', 'Direct2D', 'GPUI', 'HTML'] },
      { id: 'plugin', icon: 'plug', title: 'Plugins, or standalone apps', body: 'Put an NshAppView (iOS), NshView (Android) or AppView (desktop, and as a GPUI view in GPUI apps) on any screen of an existing app, or createPlayer in a web page, and load modules into it at run time: features ship on your own schedule. The same modules also package into standalone apps and static sites with nsh package.', chips: ['NshAppView', 'NshView', 'AppView', 'createPlayer', 'nsh package'] },
      { id: 'tsx', icon: 'spark', title: 'AI-friendly: TSX + Tailwind', body: 'A module is one TSX file of components, signals and Tailwind classes: the format models write best. Every element, prop and module has TypeScript declarations generated from the Rust sources, and the docs are served to models as llms.txt.', chips: ['TSX', 'Tailwind', 'llms.txt'] },
      { id: 'check', icon: 'check', title: 'Checked on the server', body: 'nsh trace runs a module headless and reports errors; the compiler also runs in-process or in a browser. Generate, check, retry.', chips: ['nsh trace', 'compile_module'] },
      { id: 'sandbox', icon: 'lock', title: 'Untrusted, and contained', body: 'One QuickJS VM per view, with memory, call-time and node limits, reaching only the capabilities the host grants.', chips: ['NshLimits', 'grantCapabilities'] },
      { id: 'signed', icon: 'shield', title: 'Signed, revocable delivery', body: 'Modules arrive as Ed25519-signed .nshpkg files; release keys are certified by an offline root and revocations are checked on device.', chips: ['nsh publish', 'NshTrust'] },
    ];

const uses = zh
  ? [
      { tag: '设计初衷', label: 'AI 生成的界面', title: '用界面而不是文字回答', body: '模型为每次请求写一个模块，服务器检查并签名，应用在沙箱里原生地显示它。', code: 'ai', checks: ['每个回答一个 TSX 文件', '下发前完成类型检查与 trace', '只拥有宿主授予的能力'], cta: '为什么做 NSH', href: 'docs' },
      { tag: '', label: '原生应用插件', title: '发布之后再扩展应用', body: '在任意页面嵌入 NshAppView（iOS）、NshView（Android）、AppView（macOS、Windows、Linux 与 GPUI 应用）或在网页里用 createPlayer，承载团队、合作方或用户之后编写的功能。', code: 'host', checks: ['一个页面可以放多个模块', '宿主注册自己的原生组件', '更新随时下发'], cta: '各平台的嵌入方式', href: 'docs/platforms' },
      { tag: '', label: '独立应用', title: '也能组成完整的应用', body: '同样的模块可以用 nsh package 打成可安装的 iOS、Android、macOS、Windows、Linux 应用，用 GPUI 运行的桌面应用，或一个静态网站，适合试用和小工具。', code: 'app', checks: ['使用预编译的运行时', '一条命令打出安装包', '保存即热更新开发'], cta: '打包', href: 'docs/packaging' },
    ]
  : [
      { tag: 'Designed for', label: 'AI-generated UI', title: 'Answer with an interface', body: 'A model writes a module per request, your server checks and signs it, and the app shows it natively, in a sandbox.', code: 'ai', checks: ['One TSX file per answer', 'Type-checked and traced before it ships', 'Only the capabilities the host grants'], cta: 'Why NSH exists', href: 'docs' },
      { tag: '', label: 'Plugins for native apps', title: 'Extend the app after release', body: 'Embed an NshAppView (iOS), NshView (Android), AppView (macOS, Windows, Linux and GPUI apps) or createPlayer (a web page) on any screen and host features your team, partners or users write later.', code: 'host', checks: ['Several modules on one screen', 'The host’s own native components', 'Updates delivered whenever you choose'], cta: 'Embedding, per platform', href: 'docs/platforms' },
      { tag: '', label: 'Standalone apps', title: 'Or a whole app', body: 'The same modules can become an installable iOS, Android, macOS, Windows or Linux app, a desktop app running on GPUI, or a static website with nsh package — for trying nsh and for small tools.', code: 'app', checks: ['The prebuilt runtime', 'One command builds the app', 'Hot reload while you develop'], cta: 'Packaging', href: 'docs/packaging' },
    ];

// Platforms in the order the docs list them: phones, desktops, GPUI (all
// three desktops), then the web.
const platforms = zh
  ? [
      { name: 'iOS', detail: 'UIKit · iOS 15+', cmd: '--target ios', status: '已支持', kind: 'ok' },
      { name: 'Android', detail: 'Android View · API 28+', cmd: '--target android', status: '已支持', kind: 'ok' },
      { name: 'macOS', detail: 'AppKit · macOS 14+', cmd: '--target macos', status: '已支持', kind: 'ok' },
      { name: 'Windows', detail: 'Win32 · Direct2D · Windows 10 1809+', cmd: '--target windows', status: '已支持', kind: 'ok' },
      { name: 'Linux', detail: 'GTK 4.14+', cmd: '--target linux', status: '已支持', kind: 'ok' },
      { name: 'GPUI', detail: 'GPUI · macOS / Windows / Linux', cmd: '--target gpui', status: '已支持', kind: 'ok' },
      { name: 'Web', detail: 'HTML · 现代浏览器', cmd: '--target web', status: '已支持', kind: 'ok' },
    ]
  : [
      { name: 'iOS', detail: 'UIKit · iOS 15+', cmd: '--target ios', status: 'Supported', kind: 'ok' },
      { name: 'Android', detail: 'Android View · API 28+', cmd: '--target android', status: 'Supported', kind: 'ok' },
      { name: 'macOS', detail: 'AppKit · macOS 14+', cmd: '--target macos', status: 'Supported', kind: 'ok' },
      { name: 'Windows', detail: 'Win32 · Direct2D · Windows 10 1809+', cmd: '--target windows', status: 'Supported', kind: 'ok' },
      { name: 'Linux', detail: 'GTK 4.14+', cmd: '--target linux', status: 'Supported', kind: 'ok' },
      { name: 'GPUI', detail: 'GPUI · macOS / Windows / Linux', cmd: '--target gpui', status: 'Supported', kind: 'ok' },
      { name: 'Web', detail: 'HTML · modern browsers', cmd: '--target web', status: 'Supported', kind: 'ok' },
    ];

// Hand-colored snippets: real API, coloured with the site's code tokens.
const k = (s: string) => `<span class="c-k">${s}</span>`;
const st = (s: string) => `<span class="c-s">${s}</span>`;
const fn = (s: string) => `<span class="c-f">${s}</span>`;
const cm = (s: string) => `<span class="c-c">${s}</span>`;
const ty = (s: string) => `<span class="c-t">${s}</span>`;
const snippets: Record<string, string> = {
  ai: [
    `${k('import')} { mount, signal, View } ${k('from')} ${st('"nsh"')};`,
    ``,
    `${k('function')} ${fn('Answer')}() {`,
    `  ${k('const')} range = ${fn('signal')}(${st('"1W"')});`,
    `  ${k('return')} &lt;${ty('View')} class=${st('"gap-3 p-4"')}&gt;…&lt;/${ty('View')}&gt;;`,
    `}`,
    `${fn('mount')}(Answer);`,
  ].join('\n'),
  host: [
    `${k('let')} app = ${ty('NshAppView')}()`,
    `${k('try')} app.${fn('grantCapabilities')}(grants)`,
    `${k('let')} info = ${k('try await')} app`,
    `  .${fn('loadPackage')}(at: file, trust: trust)`,
    `${cm('// verified, sandboxed, running')}`,
    `${cm('// NshView on Android, AppView elsewhere')}`,
  ].join('\n'),
  app: [
    `${cm('$')} nsh init my-app`,
    `${cm('$')} nsh run my-app --target macos`,
    `${cm('$')} nsh package my-app --target windows`,
    `${cm('# ios · android · macos · windows')}`,
    `${cm('# linux · gpui · web')}`,
  ].join('\n'),
};
const heroSnippet = `nsh run App.tsx ${k('--target')} ${st('&lt;platform&gt;')}`;

const icons: Record<string, string> = {
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9.5 13l-2 2 2 2M14.5 13l2 2-2 2"/>',
  braces: '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  check: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  devices: '<rect x="2" y="4" width="15" height="11" rx="1.5"/><path d="M6 19h7M9.5 15v4"/><rect x="16" y="9" width="6" height="11" rx="1.5"/>',
  scale: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM7 21h10M12 3v18M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  building: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  plug: '<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4"/>',
  spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/>',
};
const icon = (name: string, size = 16) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<main class="home" id="main">
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero">
    <HeroField />
    <div class="band__inner hero__inner">
      <div class="hero__copy rise">
        <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{copy.eyebrow}</span>
        <h1>{copy.title[0]}<br />{copy.title[1]}</h1>
        <p class="hero__lead">{copy.lead}</p>
        <div class="hero__actions">
          <a href={link('docs')} class="btn btn--primary">{copy.start}<Fragment set:html={icon('arrow')} /></a>
          <a href={link('playground')} class="btn">{copy.try}</a>
        </div>
        <div class="hero__platforms">
          <span><Fragment set:html={icon('devices', 14)} />{copy.runsOn}</span>
          <ul>{platforms.filter((p) => p.kind === 'ok').map((p) => <li>{p.name}</li>)}</ul>
        </div>
        <ul class="hero__meta">
          {copy.meta.map(([i, text]) => <li><Fragment set:html={icon(i, 14)} />{text}</li>)}
        </ul>
        <div class="hero__snippet"><span>{copy.snippetLang}</span><code set:html={heroSnippet} /></div>
      </div>

      <figure class="stage rise rise--2" data-stage>
        <!-- The gallery's AI chat (demos/home-chat.tsx), live, in a frame of
             the site's design: a slim bar, the app on an inset surface. -->
        <div class="device">
          <div class="device__bar">
            <span class="device__tile" set:html={icon('spark', 13)} />
            <span class="device__title">{copy.demo.title}</span>
            <span class="device__badge"><i aria-hidden="true"></i>{copy.demo.badge}</span>
          </div>
          <div class="device__screen">
            {player
              ? <iframe data-chat allow="clipboard-write" data-player-src={chatSrc} title={copy.demo.frame} loading="eager"></iframe>
              : <p class="device__pending">{copy.demo.pending}</p>}
          </div>
        </div>
        <figcaption class="legend">
          <span>{copy.demo.caption}</span>
          <button type="button" class="legend__replay" data-replay>{copy.replay}</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- AI friendly ----------------------------------------------------- -->
  <section class="band">
    <div class="band__inner">
      <header class="section-head">
        <span class="kicker">{copy.capKicker}</span>
        <h2>{copy.capTitle}</h2>
        <p>{copy.capLead}</p>
      </header>
      <div class="caps">
        {caps.map((c) => (
          <article class="cap">
            <h3><Fragment set:html={icon(c.icon)} />{c.title}</h3>
            <p>{c.body}</p>
            <ul class="chips">{c.chips.map((x) => <li>{x}</li>)}</ul>
            <div class={`mini mini--${c.id}`} aria-hidden="true">
              {c.id === 'tsx' && (
                <div class="mini-code">
                  <span class="mini-file">answer.tsx</span>
                  <i style="--w:46%;--c:var(--code-keyword)"></i>
                  <i style="--w:28%;--c:var(--code-fn);--x:12px"></i>
                  <i style="--w:62%;--c:var(--code-string);--x:24px"></i>
                  <i style="--w:38%;--c:var(--code-type);--x:24px"></i>
                  <i style="--w:20%;--c:var(--code-fn);--x:12px"></i>
                </div>
              )}
              {c.id === 'plugin' && (
                <div class="mini-plugin">
                  <div class="app">
                    <i style="--w:44%"></i>
                    <div class="slot"><code>.nshpkg</code><span set:html={icon('arrow', 12)} /><code>NshAppView</code></div>
                    <i style="--w:62%"></i>
                  </div>
                </div>
              )}
              {c.id === 'check' && (
                <ul class="mini-checks">
                  <li><span set:html={icon('check', 12)} /><code>build</code><i style="--w:72%"></i></li>
                  <li><span set:html={icon('check', 12)} /><code>trace</code><i style="--w:88%"></i></li>
                  <li><span set:html={icon('check', 12)} /><code>tap</code><i style="--w:54%"></i></li>
                </ul>
              )}
              {c.id === 'sandbox' && (
                <div class="mini-sandbox">
                  <div class="meters">
                    <span><code>memory</code><i style="--w:38%"></i></span>
                    <span><code>call</code><i style="--w:16%"></i></span>
                    <span><code>nodes</code><i style="--w:24%"></i></span>
                  </div>
                  <div class="grants">
                    <span class="grant grant--ok">api.example.com</span>
                    <span class="grant grant--no">statusBar</span>
                  </div>
                </div>
              )}
              {c.id === 'signed' && (
                <div class="mini-signed">

// The eight platforms, each one arch of the hero, from the bead outward.
const surfaces = [
  { name: 'macOS', views: 'AppKit', text: 'CoreText', input: 'NSTextView', needs: 'macOS 14+', cmd: 'macos' },
  { name: 'Linux', views: 'GTK 4', text: 'Pango', input: 'GtkTextView', needs: 'GTK 4.14+', cmd: 'linux' },
  { name: 'Windows', views: 'Win32, Direct2D', text: 'DirectWrite', input: zh ? 'NSH 编辑器，IMM32' : 'NSH’s editor, IMM32', needs: 'Windows 10 1809+', cmd: 'windows' },
  { name: 'Web', views: 'HTML, CSS', text: zh ? '浏览器' : 'The browser’s', input: '<input>, <textarea>', needs: zh ? '现代浏览器' : 'Modern browsers', cmd: 'web' },
  { name: 'iOS', views: 'UIKit', text: 'CoreText', input: 'UITextView', needs: 'iOS 15+', cmd: 'ios' },
  { name: 'Android', views: zh ? 'Android View' : 'Android views', text: 'StaticLayout', input: 'EditText', needs: 'API 28+', cmd: 'android' },
  { name: 'TUI', views: 'ratatui', text: zh ? '终端字体' : 'The terminal’s font', input: zh ? 'readline 按键，输入法' : 'Readline keys, input methods', needs: 'macOS, Windows, Linux', cmd: 'tui' },
  { name: 'GPUI', views: 'GPUI', text: zh ? 'GPUI 文本系统' : 'GPUI’s text system', input: zh ? 'NSH 编辑器' : 'NSH’s editor', needs: zh ? '嵌入 GPUI Kit 应用' : 'Embedded in GPUI Kit apps', cmd: 'gpui' },
];


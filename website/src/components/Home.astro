</main>

<script>
  // The hero's chat follows the page's theme: the player's `?theme=` when
  // it loads, a message when the theme changes. Replay reloads it, which
  // plays the scenario again.
  for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
    const frame = stage.querySelector<HTMLIFrameElement>('[data-chat]');
    if (!frame) continue;
    const theme = () => (document.documentElement.classList.contains('light') ? 'light' : 'dark');
    const themed = (src: string) => src.replace(/theme=(dark|light)/, `theme=${theme()}`);
    // The URL waits in `data-player-src` until the theme is known, so the
    // chat loads once, in the page's theme.
    frame.src = themed(frame.dataset.playerSrc!);
    new MutationObserver(() => frame.contentWindow?.postMessage({ theme: theme() }, '*')).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
    stage.querySelector('[data-replay]')?.addEventListener('click', () => (frame.src = themed(frame.src)));
  }
</script>


      { label: 'Dynamic UI and plugins', body: 'Embed a view on any screen and load signed TSX modules into it at run time, next to the host’s own native components.', code: 'host', cta: 'Embedding, per platform', href: 'docs/platforms' },
      { label: 'AI-generated UI', body: 'A model writes a module per request, so the app answers with an interface. Your server checks and signs it.', code: 'ai', cta: 'Signing and sandboxing', href: 'docs/sandbox-and-capabilities' },
    ];

const found = zh
  ? [
      { title: '无样式的基础组件', body: '导航、对话框、菜单、弹出层、标签页、选择器、数据表格、代码编辑器、富文本内核。用 Tailwind 类或类型化样式设计每个部分。', chips: 'nsh/base', href: 'docs/jsx-and-components' },
